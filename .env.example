# SentinelSpread Environment Configuration Example
# Copy to .env and adjust values for your local environment

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Configuration File Path
SENTINEL_CONFIG_PATH=config.yaml

# Hardware / Radio Settings (when mode is hardware)
PLUTO_URI=ip:192.168.2.1
RTL_SDR_INDEX=0
