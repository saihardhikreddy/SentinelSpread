options:
  parameters:
    author: SentinelSpread Team
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: SentinelSpread GNU Radio Software SDR Loopback
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: sentinelspread_flowgraph
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: SentinelSpread GNU Radio Software SDR Loopback
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '200000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 12]
    rotation: 0
    state: enabled

- name: sps
  id: variable
  parameters:
    comment: ''
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 12]
    rotation: 0
    state: enabled

- name: spreading_factor
  id: variable
  parameters:
    comment: ''
    value: '16'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 12]
    rotation: 0
    state: enabled

- name: rrc_taps
  id: variable
  parameters:
    comment: ''
    value: filter.firdes.root_raised_cosine(2.0, 4.0, 1.0, 0.35, 41)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 12]
    rotation: 0
    state: enabled

- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport sentinelspread.gnuradio.blocks\
      \ as ssb\n\nclass blk(gr.sync_block):\n    def __init__(self, message='SentinelSpread\
      \ GNU Radio SDR Software Loopback Verification 2026', spreading_factor=16):\n\
      \        gr.sync_block.__init__(self, name='crypto_dsss_tx', in_sig=None, out_sig=[np.complex64])\n\
      \        self.impl = ssb.crypto_dsss_tx(message=message, spreading_factor=spreading_factor)\n\
      \    def work(self, input_items, output_items):\n        return self.impl.work(input_items,\
      \ output_items)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    message: '''SentinelSpread GNU Radio SDR Software Loopback Verification 2026'''
    minoutbuf: '0'
    spreading_factor: spreading_factor
  states:
    _io_cache: ('crypto_dsss_tx', 'blk', [('message', "'SentinelSpread GNU Radio SDR Software Loopback Verification 2026'"), ('spreading_factor', '16')], [], [('0', 'complex', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 164.0]
    rotation: 0
    state: enabled

- name: blocks_throttle_0
  id: blocks_throttle
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 172.0]
    rotation: 0
    state: enabled

- name: interp_fir_filter_xxx_0
  id: interp_fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    interp: sps
    maxoutbuf: '0'
    minoutbuf: '0'
    taps: rrc_taps
    type: ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [464, 164.0]
    rotation: 0
    state: enabled

- name: channels_channel_model_0
  id: channels_channel_model
  parameters:
    affinity: ''
    alias: ''
    block_tags: 'False'
    comment: ''
    epsilon: '1.0'
    freq_offset: '0.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_voltage: '0.02'
    seed: '42'
    taps: 1.0 + 0.0j
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [696, 132.0]
    rotation: 0
    state: enabled

- name: fir_filter_xxx_0
  id: fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    decim: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    taps: rrc_taps
    type: ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [928, 164.0]
    rotation: 0
    state: enabled

- name: digital_symbol_sync_xx_0
  id: digital_symbol_sync_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    constellation: digital.constellation_bpsk().base()
    damping: '1.0'
    loop_bw: '0.045'
    max_dev: '1.5'
    maxoutbuf: '0'
    minoutbuf: '0'
    nfilters: '128'
    osps: '1'
    pfb_mf_taps: '[]'
    resamp_type: digital.IR_MMSE_8TAP
    sps: sps
    ted_gain: '1.0'
    ted_type: digital.TED_MUELLER_AND_MULLER
    type: cc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1136, 116.0]
    rotation: 0
    state: enabled

- name: digital_costas_loop_cc_0
  id: digital_costas_loop_cc
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    order: '2'
    use_snr: 'False'
    w: '0.0628'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1416, 168.0]
    rotation: 0
    state: enabled

- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport sentinelspread.gnuradio.blocks\
      \ as ssb\nimport pmt\n\nclass blk(gr.sync_block):\n    def __init__(self, expected_message='SentinelSpread\
      \ GNU Radio SDR Software Loopback Verification 2026', spreading_factor=16):\n\
      \        gr.sync_block.__init__(self, name='dsss_crypto_rx', in_sig=[np.complex64],\
      \ out_sig=None)\n        self.impl = ssb.dsss_crypto_rx(expected_message=expected_message,\
      \ spreading_factor=spreading_factor)\n        self.message_port_register_out(pmt.intern('msg_out'))\n\
      \    def work(self, input_items, output_items):\n        return self.impl.work(input_items,\
      \ output_items)\n    def stop(self):\n        self.impl.stop()\n        return\
      \ super().stop()\n"
    affinity: ''
    alias: ''
    comment: ''
    expected_message: '''SentinelSpread GNU Radio SDR Software Loopback Verification
      2026'''
    maxoutbuf: '0'
    minoutbuf: '0'
    spreading_factor: spreading_factor
  states:
    _io_cache: ('dsss_crypto_rx', 'blk', [('expected_message', "'SentinelSpread GNU Radio SDR Software Loopback Verification 2026'"), ('spreading_factor', '16')], [('0', 'complex', 1)], [('msg_out', 'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1648, 164.0]
    rotation: 0
    state: enabled

connections:
- [epy_block_0, '0', blocks_throttle_0, '0']
- [blocks_throttle_0, '0', interp_fir_filter_xxx_0, '0']
- [interp_fir_filter_xxx_0, '0', channels_channel_model_0, '0']
- [channels_channel_model_0, '0', fir_filter_xxx_0, '0']
- [fir_filter_xxx_0, '0', digital_symbol_sync_xx_0, '0']
- [digital_symbol_sync_xx_0, '0', digital_costas_loop_cc_0, '0']
- [digital_costas_loop_cc_0, '0', epy_block_1, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
